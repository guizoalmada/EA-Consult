    {
      "id": "cc680a60-8d80-4d7d-8926-2e70db302fe3",
      "name": "Validar Agenda",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        672
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const hoje = $today.toISODate();\nconst lojas = {}; $('Buscar Lojas').all().forEach(i => { lojas[String(i.json.codcl).trim()] = i.json.id; });\nconst users = $('Buscar Usuarios (agenda)').all().map(i => i.json);\nfunction norm(s){ return String(s||'').trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,''); }\nconst out = [];\nfor (const it of $input.all()) {\n  const r = it.json;\n  if (String(r.status_importacao || '').trim() !== '') continue;\n  const rowNum = r.row_number;\n  const dataStr = String(r.data || '').trim();\n  const cod = String(r.cod_loja || '').trim();\n  const resp = String(r.responsavel || '').trim();\n  const erros = [];\n  let dataIso = null;\n  const m = dataStr.match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4})$/);\n  if (!m) erros.push('data invalida (dd/mm/aaaa)');\n  else { dataIso = m[3]+'-'+m[2]+'-'+m[1]; if (dataIso < hoje) erros.push('data no passado'); }\n  const lojaId = lojas[cod];\n  if (!lojaId) erros.push('cod_loja nao encontrado');\n  const u = users.find(x => norm(x.nome) === norm(resp));\n  if (!u) erros.push('responsavel nao e usuario ativo que faz visitas');\n  if (erros.length) out.push({ json: { tipo:'erro', row_number: rowNum, status_importacao:'✖ erro', observacao_erro: erros.join('; ') } });\n  else out.push({ json: { tipo:'ok', row_number: rowNum, data: dataIso, usuario_id: u.id, loja_id: lojaId, status_importacao: '✔ importada ' + $now.toFormat('dd/LL HH:mm'), observacao_erro: '' } });\n}\nreturn out;"
      }
    },
