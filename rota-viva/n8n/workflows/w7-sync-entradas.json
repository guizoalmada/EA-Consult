    {
      "id": "c7b66baa-9cbe-417f-8c80-c50925319d3f",
      "name": "Aplicar Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const prot = ['google_sheets_id','emails_relatorio'];\nconst numKeys = ['meta_visitas_dia','meta_visitas_mes','sla_dias_padrao','raio_checkin_m'];\nconst horaKeys = ['hora_envio_rota','hora_relatorio'];\nconst dbc = {}; $('Buscar DB Config').all().forEach(i => { dbc[i.json.chave] = i.json.valor; });\nconst users = $('Buscar Usuarios (config)').all().map(i => i.json);\nfunction norm(s){ return String(s||'').trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,''); }\nconst out = [];\nfor (const it of $input.all()) {\n  const chave = String(it.json.chave || '').trim();\n  const valor = (it.json.valor === undefined || it.json.valor === null) ? '' : String(it.json.valor).trim();\n  if (!chave || prot.indexOf(chave) >= 0) continue;\n  if (chave.indexOf('meta_visitas_dia:') === 0) {\n    const nome = chave.slice(17).trim();\n    const u = users.find(x => norm(x.nome) === norm(nome));\n    if (!u) { out.push({ json: { tipo:'aviso', msg:'meta: usuario nao encontrado - '+nome } }); continue; }\n    if (valor !== '' && !/^\\d+$/.test(valor)) { out.push({ json: { tipo:'aviso', msg:'meta invalida p/ '+nome+': '+valor } }); continue; }\n    out.push({ json: { tipo:'meta', usuario_id: u.id, valor: valor === '' ? null : parseInt(valor,10) } });\n    continue;\n  }\n  if (numKeys.indexOf(chave) >= 0 && !/^\\d+(\\.\\d+)?$/.test(valor)) { out.push({ json: { tipo:'aviso', msg:'numerico invalido p/ '+chave+': '+valor } }); continue; }\n  if (horaKeys.indexOf(chave) >= 0 && !/^([01]\\d|2[0-3]):[0-5]\\d$/.test(valor)) { out.push({ json: { tipo:'aviso', msg:'horario invalido p/ '+chave+': '+valor } }); continue; }\n  if (dbc[chave] === valor) continue;\n  out.push({ json: { tipo:'config', chave: chave, valor: valor } });\n}\nreturn out;"
      }
    },
