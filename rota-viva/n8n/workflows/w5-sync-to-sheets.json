    {
      "parameters": {
        "jsCode": "const r = $input.first() ? $input.first().json : null;\nconst sheetId = Array.isArray(r) ? (r[0] && r[0].valor) : (r && r.valor);\nreturn [{ json: { sheetId: sheetId || '' } }];"
