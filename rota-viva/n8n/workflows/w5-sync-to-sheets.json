    {
      "parameters": {
        "jsCode": "return $input.all().map(i => { const v = i.json; const l = v.lojas || {}; return { json: {\n  id: v.id,\n  data: v.checkin_at ? String(v.checkin_at).slice(0,10) : '',\n  usuario: v.usuarios ? v.usuarios.nome : '',\n  loja: l.nome || '',\n  codcl: l.codcl || '',\n  distancia_m: v.distancia_m,\n  suspeito: v.flag_suspeito,\n  falou_decisor: v.falou_decisor,\n  resultado: v.resultado,\n  produto: v.produto_interesse,\n  status: v.status_1,\n  data_retorno: v.data_retorno,\n  motivo: v.motivo_nao_fechamento,\n  obs: v.obs_texto || v.obs_audio_transcrito || '',\n  contato: l.contato || '',\n  telefone: (Array.isArray(l.telefones) && l.telefones.length) ? l.telefones[0] : ''\n} }; });"
      },
