        "jsCode": "const item = $json;\nconst promos = item.PROMO || [];\nconst dates = item.data_normalizada || [];\nconst semGeoFlags = item.sem_geo || [];\nconst naoReconhecidosRaw = item.promo_nao_reconhecido || [];\nconst n = promos.length;\nconst distinct = new Set(promos.filter((p) => p !== undefined && p !== null && p !== '')).size;\nconst k = semGeoFlags.filter((f) => f === true).length;\n\n// linhas cujo nome na coluna PROMO nao casou com nenhum usuario que faz visitas:\n// foram importadas como pendentes sem responsavel e precisam ser corrigidas.\nconst naoReconhecidos = naoReconhecidosRaw.filter((p) => p !== undefined && p !== null && String(p).trim() !== '');\nconst nomesUnicos = Array.from(new Set(naoReconhecidos.map((p) => String(p).trim())));\nconst qtdNaoReconhecidas = naoReconhecidos.length;\nconst aviso = qtdNaoReconhecidas > 0\n  ? '\\n\\n' + qtdNaoReconhecidas + ' linha' + (qtdNaoReconhecidas > 1 ? 's' : '') +\n    ' com responsavel nao reconhecido: ' + nomesUnicos.join(', ') +\n    '\\nEssas visitas foram importadas sem responsavel.'\n  : '';\n\nconst isoDate = dates.length > 0 ? dates[0] : null;\nlet dataDisplay = '';\nif (isoDate) {\n  const d = new Date(isoDate + 'T00:00:00Z');\n  const dd = String(d.getUTCDate()).padStart(2, '0');\n  const mm = String(d.getUTCMonth() + 1).padStart(2, '0');\n  const yyyy = d.getUTCFullYear();\n  dataDisplay = dd + '/' + mm + '/' + yyyy;\n}\nreturn {\n  json: {\n    n: n,\n    m: distinct,\n    k: k,\n    qtdNaoReconhecidas: qtdNaoReconhecidas,\n    nomesNaoReconhecidos: nomesUnicos,\n    aviso: aviso,\n    data: dataDisplay\n  }\n};"
      }
    },
