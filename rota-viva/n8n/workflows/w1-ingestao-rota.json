    {
      "id": "fe5e3c6f-1c03-4aa1-bce0-4e2efbe8e052",
      "name": "Interpretar Resultado Geocoding",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        -400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const body = $json;\nlet lat = null;\nlet long = null;\ntry {\n  if (body && Array.isArray(body.results) && body.results.length > 0 && body.results[0].geometry && body.results[0].geometry.location) {\n    lat = body.results[0].geometry.location.lat;\n    long = body.results[0].geometry.location.lng;\n  } else if (body && typeof body.lat !== 'undefined' && (typeof body.lon !== 'undefined' || typeof body.lng !== 'undefined')) {\n    lat = body.lat;\n    long = typeof body.lon !== 'undefined' ? body.lon : body.lng;\n  }\n} catch (e) {\n  lat = null;\n  long = null;\n}\nif (typeof lat !== 'number' || typeof long !== 'number' || Number.isNaN(lat) || Number.isNaN(long)) {\n  lat = null;\n  long = null;\n}\nreturn {\n  json: {\n    id: $('Upsert Loja').item.json.id,\n    codcl: $('Upsert Loja').item.json.codcl,\n    lat: lat,\n    long: long\n  }\n};"
