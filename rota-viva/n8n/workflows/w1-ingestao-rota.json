      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const row = $json;\nconst serial = Number(row.DATA);\nlet dataNormalizada = null;\nif (!isNaN(serial)) {\n  const ms = Date.UTC(1899, 11, 30) + serial * 86400 * 1000;\n  const d = new Date(ms);\n  dataNormalizada = d.toISOString().slice(0, 10);\n}\nlet telefones = [];\nif (row.FONE !== undefined && row.FONE !== null && String(row.FONE).trim().length > 0) {\n  telefones = String(row.FONE).split(',').map((s) => s.trim()).filter((s) => s.length > 0);\n}\nreturn {\n  json: {\n    ...row,\n    data_normalizada: dataNormalizada,\n    telefones: telefones\n  }\n};"
      }
    },
