        "url": "https://zvqwjtndvbqryonjplal.supabase.co/rest/v1/agenda_visitas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "usuario_id",
              "value": "=eq.{{ $json.id }}"
            },
            {
              "name": "data",
              "value": "=eq.{{ $now.toFormat(\"yyyy-LL-dd\") }}"
            },
