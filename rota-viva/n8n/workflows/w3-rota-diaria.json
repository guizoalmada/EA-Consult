    {
      "parameters": {
        "jsCode": "const usuario = $input.first().json;\n\n// O alerta serve para o coordenador saber que alguem de campo ficou sem rota.\n// Coordenador e gerente tambem fazem visitas (D-06), mas nem sempre tem rota no dia:\n// a ausencia de rota deles e normal e nao deve virar alerta diario.\nif (usuario.papel === 'coordenador' || usuario.papel === 'gerente') {\n  return [];\n}\n\nconst coordenadores = $('Buscar Coordenadores Ativos').all().map(function (item) { return item.json; });\n\nreturn coordenadores.map(function (c) {\n  return {\n    json: {\n      coordenador_nome: c.nome,\n      coordenador_telefone: c.telefone,\n      usuario_nome: usuario.nome,\n      data: usuario.dataFormatada\n    }\n  };\n});\n"
      },
