      "id": "6875e587-f2e0-4cc3-b724-d289166a9b52",
      "name": "Buscar Visitas Pendentes do Dia",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        912,
        -256
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const usuario = $('Loop Usuários').first().json;\nconst rawItems = $input.all().map(function (item) { return item.json; });\nconst visitas = rawItems.filter(function (v) { return v && v.id; });\nconst retornos = visitas.filter(function (v) { return v.origem === 'retorno'; });\n\nfunction formatVisita(v, idx) {\n  const loja = v.lojas || {};\n  const nome = loja.nome || 'Loja sem nome';\n  const bairro = loja.bairro || '-';\n  const contato = loja.contato || '-';\n  const telefonesRaw = loja.telefones;\n  const telefones = Array.isArray(telefonesRaw) ? telefonesRaw.join(', ') : (telefonesRaw || '-');\n  return (idx + 1) + '. ' + nome + ' - ' + bairro + ' - ' + contato + ' - ' + telefones;\n}\n\nconst listaVisitasTexto = visitas.length > 0\n  ? visitas.map(function (v, idx) { return formatVisita(v, idx); }).join('\\n')\n  : 'Nenhuma visita.';\n\nconst listaRetornosTexto = retornos.length > 0\n  ? retornos.map(function (v, idx) { return formatVisita(v, idx); }).join('\\n')\n  : 'nenhum';\n\nreturn [{\n  json: {\n    usuario_id: usuario.id,\n    nome: usuario.nome,\n    papel: usuario.papel,\n    telefone: usuario.telefone,\n    hasVisits: visitas.length > 0,\n    qtdVisitas: visitas.length,\n    listaVisitasTexto: listaVisitasTexto,\n    listaRetornosTexto: listaRetornosTexto,\n    dataFormatada: $now.toFormat('dd/LL')\n  }\n}];\n"
      },
      "id": "8ace8d60-4d3e-4bac-b912-7f2edffa3741",
