{
  "id": "4jArhsdZUcRbEbau",
  "name": "[RotaViva] W6 - Lembrete Retorno",
  "active": false,
  "description": "Todos os dias às 08:00, busca visitas com data_retorno=hoje, envia lembrete WhatsApp ao promotor responsável e cria agenda_visitas de retorno (evitando duplicatas) para aparecer na rota do dia.",
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  },
  "tags": [],
  "connections": {
    "Trigger Diário 08:00": {
      "main": [
        [{ "node": "Buscar Visitas Retorno Hoje", "type": "main", "index": 0 }]
      ]
    },
    "Buscar Visitas Retorno Hoje": {
      "main": [
        [{ "node": "Loop Visitas Retorno", "type": "main", "index": 0 }]
      ]
    },
    "Loop Visitas Retorno": {
      "main": [
        null,
        [{ "node": "Enviar Lembrete Retorno", "type": "main", "index": 0 }]
      ]
    },
    "Enviar Lembrete Retorno": {
      "main": [
        [{ "node": "Verificar Agenda Existente", "type": "main", "index": 0 }]
      ]
    },
    "Verificar Agenda Existente": {
      "main": [
        [{ "node": "Agenda de Retorno Já Existe?", "type": "main", "index": 0 }]
      ]
    },
    "Agenda de Retorno Já Existe?": {
      "main": [
        [{ "node": "Loop Visitas Retorno", "type": "main", "index": 0 }],
        [{ "node": "Criar Agenda Retorno", "type": "main", "index": 0 }]
      ]
    },
    "Criar Agenda Retorno": {
      "main": [
        [{ "node": "Loop Visitas Retorno", "type": "main", "index": 0 }]
      ]
    }
  },
  "nodes": [
    {
      "id": "1f4bcd28-ddc7-4872-a4c4-c0a779876c5b",
      "name": "Trigger Diário 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 0 8 * * *" }]
        }
      }
    },
    {
      "id": "a84fea06-0019-4876-9034-c2988c849a66",
      "name": "Buscar Visitas Retorno Hoje",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [540, 300],
      "parameters": {
        "method": "GET",
        "url": "https://zvqwjtndvbqryonjplal.supabase.co/rest/v1/visitas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            { "name": "data_retorno", "value": "=eq.{{ $now.toFormat(\"yyyy-MM-dd\") }}" },
            { "name": "select", "value": "*,usuarios(nome,telefone),lojas(nome,bairro,contato,telefones)" }
          ]
        },
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [{ "name": "Accept-Profile", "value": "rotaviva" }]
        }
      },
      "credentials": {
        "httpCustomAuth": { "name": "CRED_SUPABASE_ROTAVIVA" }
      }
    },
    {
      "id": "aa6ccda9-6044-45d5-9b53-1a9d2754a22e",
      "name": "Loop Visitas Retorno",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [840, 300],
      "parameters": { "batchSize": 1 }
    },
    {
      "id": "9c390b3c-9957-4165-ac09-c05e22b13af0",
      "name": "Enviar Lembrete Retorno",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [1140, 200],
      "parameters": {
        "resource": "message",
        "operation": "sendTemplate",
        "phoneNumberId": "<__PLACEHOLDER_VALUE__ID do número de telefone WhatsApp Business (Meta) remetente__>",
        "recipientPhoneNumber": "={{ $json.usuarios.telefone }}",
        "template": "lembrete_retorno",
        "components": {
          "component": [
            {
              "type": "body",
              "bodyParameters": {
                "parameter": [
                  { "type": "text", "text": "={{ $json.usuarios.nome }}" },
                  { "type": "text", "text": "={{ $json.lojas.nome }}" },
                  { "type": "text", "text": "={{ $json.lojas.bairro }}" },
                  { "type": "text", "text": "={{ $json.lojas.contato || ($json.lojas.telefones && $json.lojas.telefones[0]) || \"\" }}" }
                ]
              }
            }
          ]
        }
      },
      "credentials": {
        "whatsAppApi": { "name": "CRED_META_CLOUD" }
      },
      "notes": "ATENÇÃO (blocker): o servidor n8n MCP auto-associou automaticamente a credencial REAL existente 'ARMCOM - WhatsApp Cloud API' a este node ao criar/atualizar o workflow, mesmo com credential name-only ou sem nenhuma credential especificada. Isso deve ser corrigido manualmente na UI do n8n: abrir este node e trocar a credencial para um placeholder novo chamado CRED_META_CLOUD antes do go-live."
    },
    {
      "id": "3c164420-486f-40b2-881d-5381e11c66e0",
      "name": "Verificar Agenda Existente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1440, 140],
      "alwaysOutputData": true,
      "parameters": {
        "method": "GET",
        "url": "https://zvqwjtndvbqryonjplal.supabase.co/rest/v1/agenda_visitas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            { "name": "usuario_id", "value": "=eq.{{ $(\"Loop Visitas Retorno\").item.json.usuario_id }}" },
            { "name": "loja_id", "value": "=eq.{{ $(\"Loop Visitas Retorno\").item.json.loja_id }}" },
            { "name": "data", "value": "=eq.{{ $now.toFormat(\"yyyy-MM-dd\") }}" },
            { "name": "origem", "value": "eq.retorno" },
            { "name": "select", "value": "id" }
          ]
        },
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [{ "name": "Accept-Profile", "value": "rotaviva" }]
        }
      },
      "credentials": {
        "httpCustomAuth": { "name": "CRED_SUPABASE_ROTAVIVA" }
      }
    },
    {
      "id": "c6f80899-c279-45bc-a041-c850501dfbf9",
      "name": "Agenda de Retorno Já Existe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1740, 140],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "operator": { "type": "string", "operation": "notEmpty" },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "dbcbc4b4-41b7-46b4-8405-1fb5f19dd8e6",
      "name": "Criar Agenda Retorno",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [2040, 260],
      "parameters": {
        "method": "POST",
        "url": "https://zvqwjtndvbqryonjplal.supabase.co/rest/v1/agenda_visitas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            { "name": "Content-Profile", "value": "rotaviva" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            { "name": "data", "value": "={{ $now.toFormat(\"yyyy-MM-dd\") }}" },
            { "name": "usuario_id", "value": "={{ $(\"Loop Visitas Retorno\").item.json.usuario_id }}" },
            { "name": "loja_id", "value": "={{ $(\"Loop Visitas Retorno\").item.json.loja_id }}" },
            { "name": "origem", "value": "retorno" },
            { "name": "status", "value": "pendente" }
          ]
        }
      },
      "credentials": {
        "httpCustomAuth": { "name": "CRED_SUPABASE_ROTAVIVA" }
      }
    }
  ]
}
