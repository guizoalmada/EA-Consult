        "jsCode": "const j = $json;\nconst contato = (j.lojas && (j.lojas.contato || (j.lojas.telefones && j.lojas.telefones[0]))) || '';\nreturn { json: { usuario_id: j.usuario_id, tipo: 'lembrete_retorno', variaveis: { nome: j.usuarios ? j.usuarios.nome : '', loja: j.lojas ? j.lojas.nome : '', bairro: j.lojas ? j.lojas.bairro : '', contato: contato } } };"
